ant bush.","multiblocks":[{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=dormant,stage=0]","Y":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=dormant,stage=1]","A":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=dormant,stage=2]","Z":"tfcfarmingplus:plant/redcurrant_bush_cane[lifecycle=dormant,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=healthy,stage=0]","Y":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=healthy,stage=1]","A":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=healthy,stage=2]","Z":"tfcfarmingplus:plant/redcurrant_bush_cane[lifecycle=healthy,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=flowering,stage=0]","Y":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=flowering,stage=1]","A":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=flowering,stage=2]","Z":"tfcfarmingplus:plant/redcurrant_bush_cane[lifecycle=flowering,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=fruiting,stage=0]","Y":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=fruiting,stage=1]","A":"tfcfarmingplus:plant/redcurrant_bush[lifecycle=fruiting,stage=2]","Z":"tfcfarmingplus:plant/redcurrant_bush_cane[lifecycle=fruiting,facing=east,stage=1]"}}]},{"type":"patchouli:text","title":"Haskap","anchor":"haskap","text":"Can be found in regions with: $(br)$(bold)$(l:tfc:core_mechanics/climate#temperature)Temperature$(): -14°C - 22°C$(br)$(bold)Groundwater$(): 140 - 340mm$(br)$(bold)Forest coverage$(): 2 - 4$(br2)As a crop it needs $(bold)hydration$() 35 - 85 %.$(br2)Form: $(thing)spreading$() — it puts out side branches and shoots once grown.$(br2)Haskap grows from March to April, flowers in May, and bears fruit in June. It is the hardiest and earliest ripening of this group."},{"type":"tfc:multimultiblock","text":"A typical Haskap bush.","multiblocks":[{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/haskap_bush[lifecycle=dormant,stage=0]","Y":"tfcfarmingplus:plant/haskap_bush[lifecycle=dormant,stage=1]","A":"tfcfarmingplus:plant/haskap_bush[lifecycle=dormant,stage=2]","Z":"tfcfarmingplus:plant/haskap_bush_cane[lifecycle=dormant,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/haskap_bush[lifecycle=healthy,stage=0]","Y":"tfcfarmingplus:plant/haskap_bush[lifecycle=healthy,stage=1]","A":"tfcfarmingplus:plant/haskap_bush[lifecycle=healthy,stage=2]","Z":"tfcfarmingplus:plant/haskap_bush_cane[lifecycle=healthy,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/haskap_bush[lifecycle=flowering,stage=0]","Y":"tfcfarmingplus:plant/haskap_bush[lifecycle=flowering,stage=1]","A":"tfcfarmingplus:plant/haskap_bush[lifecycle=flowering,stage=2]","Z":"tfcfarmingplus:plant/haskap_bush_cane[lifecycle=flowering,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/haskap_bush[lifecycle=fruiting,stage=0]","Y":"tfcfarmingplus:plant/haskap_bush[lifecycle=fruiting,stage=1]","A":"tfcfarmingplus:plant/haskap_bush[lifecycle=fruiting,stage=2]","Z":"tfcfarmingplus:plant/haskap_bush_cane[lifecycle=fruiting,facing=east,stage=1]"}}]},{"type":"patchouli:text","title":"Goji Berry","anchor":"goji","text":"Can be found in regions with: $(br)$(bold)$(l:tfc:core_mechanics/climate#temperature)Temperature$(): -12°C - 30°C$(br)$(bold)Groundwater$(): 40 - 220mm$(br)$(bold)Forest coverage$(): 2 - 4$(br2)As a crop it needs $(bold)hydration$() 10 - 55 %.$(br2)Form: $(thing)spreading$() — it puts out side branches and shoots once grown.$(br2)Goji Berry grows from April to May, flowers in June and again in August, and bears fruit in July and September. It can be found on dry, sunny slopes."},{"type":"tfc:multimultiblock","text":"A typical Goji Berry bush.","multiblocks":[{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/goji_bush[lifecycle=dormant,stage=0]","Y":"tfcfarmingplus:plant/goji_bush[lifecycle=dormant,stage=1]","A":"tfcfarmingplus:plant/goji_bush[lifecycle=dormant,stage=2]","Z":"tfcfarmingplus:plant/goji_bush_cane[lifecycle=dormant,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/goji_bush[lifecycle=healthy,stage=0]","Y":"tfcfarmingplus:plant/goji_bush[lifecycle=healthy,stage=1]","A":"tfcfarmingplus:plant/goji_bush[lifecycle=healthy,stage=2]","Z":"tfcfarmingplus:plant/goji_bush_cane[lifecycle=healthy,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/goji_bush[lifecycle=flowering,stage=0]","Y":"tfcfarmingplus:plant/goji_bush[lifecycle=flowering,stage=1]","A":"tfcfarmingplus:plant/goji_bush[lifecycle=flowering,stage=2]","Z":"tfcfarmingplus:plant/goji_bush_cane[lifecycle=flowering,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/goji_bush[lifecycle=fruiting,stage=0]","Y":"tfcfarmingplus:plant/goji_bush[lifecycle=fruiting,stage=1]","A":"tfcfarmingplus:plant/goji_bush[lifecycle=fruiting,stage=2]","Z":"tfcfarmingplus:plant/goji_bush_cane[lifecycle=fruiting,facing=east,stage=1]"}}]},{"type":"patchouli:text","title":"Serviceberry","anchor":"serviceberry","text":"Can be found in regions with: $(br)$(bold)$(l:tfc:core_mechanics/climate#temperature)Temperature$(): -15°C - 22°C$(br)$(bold)Groundwater$(): 120 - 320mm$(br)$(bold)Forest coverage$(): 2 - 4$(br2)As a crop it needs $(bold)hydration$() 30 - 80 %.$(br2)Form: $(thing)spreading$() — it puts out side branches and shoots once grown.$(br2)Serviceberry grows in April, flowers in May, and bears fruit in June. It can be found at forest edges and in thickets."},{"type":"tfc:multimultiblock","text":"A typical Serviceberry bush.","multiblocks":[{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=dormant,stage=0]","Y":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=dormant,stage=1]","A":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=dormant,stage=2]","Z":"tfcfarmingplus:plant/serviceberry_bush_cane[lifecycle=dormant,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=healthy,stage=0]","Y":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=healthy,stage=1]","A":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=healthy,stage=2]","Z":"tfcfarmingplus:plant/serviceberry_bush_cane[lifecycle=healthy,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=flowering,stage=0]","Y":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=flowering,stage=1]","A":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=flowering,stage=2]","Z":"tfcfarmingplus:plant/serviceberry_bush_cane[lifecycle=flowering,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=fruiting,stage=0]","Y":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=fruiting,stage=1]","A":"tfcfarmingplus:plant/serviceberry_bush[lifecycle=fruiting,stage=2]","Z":"tfcfarmingplus:plant/serviceberry_bush_cane[lifecycle=fruiting,facing=east,stage=1]"}}]},{"type":"patchouli:text","title":"Aronia","anchor":"aronia","text":"Can be found in regions with: $(br)$(bold)$(l:tfc:core_mechanics/climate#temperature)Temperature$(): -14°C - 24°C$(br)$(bold)Groundwater$(): 120 - 320mm$(br)$(bold)Forest coverage$(): 2 - 4$(br2)As a crop it needs $(bold)hydration$() 30 - 80 %.$(br2)Form: $(thing)spreading$() — it puts out side branches and shoots once grown.$(br2)Aronia grows from May to July, flowers in August, and bears fruit in September and October. It can be found in wet ground and at the edge of marshes."},{"type":"tfc:multimultiblock","text":"A typical Aronia bush.","multiblocks":[{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/aronia_bush[lifecycle=dormant,stage=0]","Y":"tfcfarmingplus:plant/aronia_bush[lifecycle=dormant,stage=1]","A":"tfcfarmingplus:plant/aronia_bush[lifecycle=dormant,stage=2]","Z":"tfcfarmingplus:plant/aronia_bush_cane[lifecycle=dormant,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/aronia_bush[lifecycle=healthy,stage=0]","Y":"tfcfarmingplus:plant/aronia_bush[lifecycle=healthy,stage=1]","A":"tfcfarmingplus:plant/aronia_bush[lifecycle=healthy,stage=2]","Z":"tfcfarmingplus:plant/aronia_bush_cane[lifecycle=healthy,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/aronia_bush[lifecycle=flowering,stage=0]","Y":"tfcfarmingplus:plant/aronia_bush[lifecycle=flowering,stage=1]","A":"tfcfarmingplus:plant/aronia_bush[lifecycle=flowering,stage=2]","Z":"tfcfarmingplus:plant/aronia_bush_cane[lifecycle=flowering,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/aronia_bush[lifecycle=fruiting,stage=0]","Y":"tfcfarmingplus:plant/aronia_bush[lifecycle=fruiting,stage=1]","A":"tfcfarmingplus:plant/aronia_bush[lifecycle=fruiting,stage=2]","Z":"tfcfarmingplus:plant/aronia_bush_cane[lifecycle=fruiting,facing=east,stage=1]"}}]},{"type":"patchouli:text","title":"Tea Bush","anchor":"tea","text":"Can be found in regions with: $(br)$(bold)$(l:tfc:core_mechanics/climate#temperature)Temperature$(): -6°C - 40°C$(br)$(bold)Groundwater$(): 80 - 380mm$(br)$(bold)Forest coverage$(): 2 - 4$(br2)As a crop it needs $(bold)hydration$() 20 - 95 %.$(br2)Form: $(thing)spreading$() — it puts out side branches and shoots once grown.$(br2)Tea Bush sends out new shoots from March to May, flowers in June and July, and is picked for its leaves from August to October. It can be found on warm, moist hillsides and takes light frost."},{"type":"tfc:multimultiblock","text":"A typical Tea Bush bush.","multiblocks":[{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/tea_bush[lifecycle=dormant,stage=0]","Y":"tfcfarmingplus:plant/tea_bush[lifecycle=dormant,stage=1]","A":"tfcfarmingplus:plant/tea_bush[lifecycle=dormant,stage=2]","Z":"tfcfarmingplus:plant/tea_bush_cane[lifecycle=dormant,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/tea_bush[lifecycle=healthy,stage=0]","Y":"tfcfarmingplus:plant/tea_bush[lifecycle=healthy,stage=1]","A":"tfcfarmingplus:plant/tea_bush[lifecycle=healthy,stage=2]","Z":"tfcfarmingplus:plant/tea_bush_cane[lifecycle=healthy,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/tea_bush[lifecycle=flowering,stage=0]","Y":"tfcfarmingplus:plant/tea_bush[lifecycle=flowering,stage=1]","A":"tfcfarmingplus:plant/tea_bush[lifecycle=flowering,stage=2]","Z":"tfcfarmingplus:plant/tea_bush_cane[lifecycle=flowering,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/tea_bush[lifecycle=fruiting,stage=0]","Y":"tfcfarmingplus:plant/tea_bush[lifecycle=fruiting,stage=1]","A":"tfcfarmingplus:plant/tea_bush[lifecycle=fruiting,stage=2]","Z":"tfcfarmingplus:plant/tea_bush_cane[lifecycle=fruiting,facing=east,stage=1]"}}]},{"type":"patchouli:text","title":"Coffee Bush","anchor":"coffee","text":"Can be found in regions with: $(br)$(bold)$(l:tfc:core_mechanics/climate#temperature)Temperature$(): 4°C - 44°C$(br)$(bold)Groundwater$(): 120 - 400mm$(br)$(bold)Forest coverage$(): 2 - 4$(br2)As a crop it needs $(bold)hydration$() 30 - 100 %.$(br2)Form: $(thing)spreading$() — it puts out side branches and shoots once grown.$(br2)Coffee Bush leafs out in March, flowers in April and May, and bears fruit from June to August. It can be found in frost free tropical highlands."},{"type":"tfc:multimultiblock","text":"A typical Coffee Bush bush.","multiblocks":[{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/coffee_bush[lifecycle=dormant,stage=0]","Y":"tfcfarmingplus:plant/coffee_bush[lifecycle=dormant,stage=1]","A":"tfcfarmingplus:plant/coffee_bush[lifecycle=dormant,stage=2]","Z":"tfcfarmingplus:plant/coffee_bush_cane[lifecycle=dormant,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/coffee_bush[lifecycle=healthy,stage=0]","Y":"tfcfarmingplus:plant/coffee_bush[lifecycle=healthy,stage=1]","A":"tfcfarmingplus:plant/coffee_bush[lifecycle=healthy,stage=2]","Z":"tfcfarmingplus:plant/coffee_bush_cane[lifecycle=healthy,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/coffee_bush[lifecycle=flowering,stage=0]","Y":"tfcfarmingplus:plant/coffee_bush[lifecycle=flowering,stage=1]","A":"tfcfarmingplus:plant/coffee_bush[lifecycle=flowering,stage=2]","Z":"tfcfarmingplus:plant/coffee_bush_cane[lifecycle=flowering,facing=east,stage=1]"}},{"pattern":[["X"," "],["Y","Z"],["A","Z"],["0"," "]],"mapping":{"X":"tfcfarmingplus:plant/coffee_bush[lifecycle=fruiting,stage=0]","Y":"tfcfarmingplus:plant/coffee_bush[lifecycle=fruiting,stage=1]","A":"tfcfarmingplus:plant/coffee_bush[lifecycle=fruiting,stage=2]","Z":"tfcfarmingplus:plant/coffee_bush_cane[lifecycle=fruiting,facing=east,stage=1]"}}]}],"read_by_default":true,"sortnum":3,"extra_recipe_mappings":{"tfcfarmingplus:plant/blackcurrant_bush":4,"tfcfarmingplus:food/blackcurrant":4,"tfcfarmingplus:plant/redcurrant_bush":6,"tfcfarmingplus:food/redcurrant":6,"tfcfarmingplus:plant/haskap_bush":8,"tfcfarmingplus:food/haskap"